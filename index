        /* ==========================================================================
           6. EXAM ENGINE (CBT CORE)
           ========================================================================== */
        function startExam() {
            userAnswers = {};
            userRagu = {};
            currentQuestionIndex = 0;
            remainingSeconds = examSettings.durationMinutes * 60;

            renderQuestionNavGrid();
            loadQuestionIndex(0);
            startTimer();

            navigateTo('page-exam');
        }

        function startTimer() {
            clearInterval(timerInterval);
            updateTimerDisplay();

            timerInterval = setInterval(() => {
                remainingSeconds--;
                updateTimerDisplay();

                if(remainingSeconds <= 0) {
                    clearInterval(timerInterval);
                    alert('Waktu ujian telah habis! Sistem akan mengumpulkan jawaban Anda secara otomatis.');
                    processExamSubmission();
                }
            }, 1000);
        }

        function updateTimerDisplay() {
            const hrs = Math.floor(remainingSeconds / 3600);
            const mins = Math.floor((remainingSeconds % 3600) / 60);
            const secs = remainingSeconds % 60;

            const format = (n) => n < 10 ? '0' + n : n;
            document.getElementById('exam-timer').innerText = `${format(hrs)}:${format(mins)}:${format(secs)}`;
        }

        function renderQuestionNavGrid() {
            const desktopGrid = document.getElementById('desktop-grid-nav');
            const mobileGrid = document.getElementById('mobile-grid-nav');

            let html = '';
            currentQuestions.forEach((q, idx) => {
                const qId = q.id;
                const isAnswered = userAnswers[qId] !== undefined;
                const isRagu = userRagu[qId] === true;
                const isCurrent = currentQuestionIndex === idx;

                let bgClass = 'bg-slate-100 text-slate-700 hover:bg-slate-200 border-slate-300';
                if(isRagu) {
                    bgClass = 'bg-amber-400 text-amber-950 font-bold border-amber-500 shadow-sm';
                } else if(isAnswered) {
                    bgClass = 'bg-emerald-600 text-white font-bold border-emerald-700 shadow-sm';
                }

                if(isCurrent) {
                    bgClass += ' ring-2 ring-brand-navy ring-offset-1';
                }

                html += `
                    <button onclick="jumpToQuestion(${idx})" class="h-9 rounded-lg border text-xs flex items-center justify-center transition-all ${bgClass}">
                        ${idx + 1}
                    </button>
                `;
            });

            desktopGrid.innerHTML = html;
            mobileGrid.innerHTML = html;

            // Update Count
            const answeredCount = Object.keys(userAnswers).length;
            document.getElementById('answered-count').innerText = answeredCount;
        }

        function loadQuestionIndex(index) {
            if(index < 0 || index >= currentQuestions.length) return;
            currentQuestionIndex = index;

            const q = currentQuestions[index];
            document.getElementById('current-question-num').innerText = index + 1;

            // Stimulus
            const stimEl = document.getElementById('question-stimulus');
            if(q.stimulus && q.stimulus.trim() !== '') {
                stimEl.innerText = q.stimulus;
                stimEl.classList.remove('hidden');
            } else {
                stimEl.classList.add('hidden');
            }

            // Question text
            document.getElementById('question-text').innerText = q.text;

            // Options
            const optsContainer = document.getElementById('options-container');
            const selectedOpt = userAnswers[q.id];

            let optsHtml = '';
            q.options.forEach((optText, optIdx) => {
                const isChecked = selectedOpt === optIdx;
                const activeStyle = isChecked ? 'border-brand-navy bg-blue-50/80 text-brand-navy ring-1 ring-brand-navy font-semibold' : 'border-slate-200 bg-white hover:bg-slate-50 text-slate-700';

                optsHtml += `
                    <button onclick="selectOption(${q.id}, ${optIdx})" class="w-full text-left p-3.5 rounded-xl border transition-all duration-150 flex items-start space-x-3 ${activeStyle}">
                        <div class="w-6 h-6 rounded-full border border-slate-300 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5 ${isChecked ? 'bg-brand-navy text-white border-brand-navy' : 'bg-slate-100 text-slate-600'}">
                            ${String.fromCharCode(65 + optIdx)}
                        </div>
                        <div class="text-xs md:text-sm leading-relaxed">${optText.replace(/^[A-E]\.\s*/, '')}</div>
                    </button>
                `;
            });
            optsContainer.innerHTML = optsHtml;

            // Badge Ragu & Ragu Button
            const isRagu = userRagu[q.id] === true;
            const badgeRagu = document.getElementById('badge-ragu-status');
            const btnRagu = document.getElementById('btn-ragu');

            if(isRagu) {
                badgeRagu.classList.remove('hidden');
                btnRagu.classList.add('bg-amber-500', 'text-white');
                btnRagu.classList.remove('bg-amber-100', 'text-amber-800');
            } else {
                badgeRagu.classList.add('hidden');
                btnRagu.classList.remove('bg-amber-500', 'text-white');
                btnRagu.classList.add('bg-amber-100', 'text-amber-800');
            }

            // Button Visibility
            document.getElementById('btn-prev').disabled = (index === 0);
            if(index === 0) {
                document.getElementById('btn-prev').classList.add('opacity-50', 'cursor-not-allowed');
            } else {
                document.getElementById('btn-prev').classList.remove('opacity-50', 'cursor-not-allowed');
            }

            if(index === currentQuestions.length - 1) {
                document.getElementById('btn-next').classList.add('hidden');
                document.getElementById('btn-finish').classList.remove('hidden');
            } else {
                document.getElementById('btn-next').classList.remove('hidden');
                document.getElementById('btn-finish').classList.add('hidden');
            }

            renderQuestionNavGrid();
        }

        function selectOption(qId, optIdx) {
            userAnswers[qId] = optIdx;
            loadQuestionIndex(currentQuestionIndex);
        }

        function toggleRaguCurrent() {
            const qId = currentQuestions[currentQuestionIndex].id;
            userRagu[qId] = !userRagu[qId];
            loadQuestionIndex(currentQuestionIndex);
        }

        function prevQuestion() {
            if(currentQuestionIndex > 0) loadQuestionIndex(currentQuestionIndex - 1);
        }

        function nextQuestion() {
            if(currentQuestionIndex < currentQuestions.length - 1) loadQuestionIndex(currentQuestionIndex + 1);
        }

        function jumpToQuestion(index) {
            loadQuestionIndex(index);
            const modal = document.getElementById('modal-nav-grid');
            if(!modal.classList.contains('hidden')) toggleNavGridModal();
        }

        function toggleNavGridModal() {
            document.getElementById('modal-nav-grid').classList.toggle('hidden');
        }

        function confirmSubmitExam() {
            const total = currentQuestions.length;
            const answered = Object.keys(userAnswers).length;
            const unanswered = total - answered;
            
            let raguCount = 0;
            Object.values(userRagu).forEach(v => { if(v) raguCount++; });

            let msg = `Apakah Anda yakin ingin mengumpulkan jawaban?\n\n- Total Soal: ${total}\n- Terjawab: ${answered}\n- Belum Dijawab: ${unanswered}\n- Soal Ragu: ${raguCount}`;

            if(unanswered > 0 || raguCount > 0) {
                msg += `\n\nCatatan: Masih ada soal yang belum dijawab/ragu!`;
            }

            if(confirm(msg)) {
                processExamSubmission();
            }
        }

        /* ==========================================================================
           7. SUBMISSION & RESULT GENERATION
           ========================================================================== */
        function processExamSubmission() {
            clearInterval(timerInterval);

            let benar = 0;
            let salah = 0;
            let kosong = 0;

            currentQuestions.forEach(q => {
                const userAns = userAnswers[q.id];
                if(userAns === undefined) {
                    kosong++;
                } else if(userAns === q.answer) {
                    benar++;
                } else {
                    salah++;
                }
            });

            const total = currentQuestions.length;
            const nilaiAkhir = Math.round((benar / total) * 100);
            const isTuntas = nilaiAkhir >= examSettings.kkm;

            // Render Result UI
            document.getElementById('result-nama').innerText = currentStudent.nama;
            document.getElementById('result-kelas').innerText = currentStudent.kelas;
            document.getElementById('result-nopes').innerText = currentStudent.nopes;

            const now = new Date();
            const timeStr = `${now.toLocaleDateString('id-ID')} ${now.toLocaleTimeString('id-ID', {hour:'2-digit', minute:'2-digit'})}`;
            document.getElementById('result-time').innerText = timeStr;

            document.getElementById('result-score').innerText = nilaiAkhir;
            document.getElementById('result-benar').innerText = benar;
            document.getElementById('result-salah').innerText = salah;
            document.getElementById('result-kosong').innerText = kosong;

            const badge = document.getElementById('result-status-badge');
            if(isTuntas) {
                badge.innerText = `LULUS / TUNTAS (KKTP >= ${examSettings.kkm})`;
                badge.className = 'inline-block px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800 border border-emerald-300';
            } else {
                badge.innerText = `BELUM TUNTAS (KKTP < ${examSettings.kkm})`;
                badge.className = 'inline-block px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-100 text-rose-800 border border-rose-300';
            }

            // Save Result to Local DB for Teacher Rekap
            saveRekapResult({
                nopes: currentStudent.nopes,
                nama: currentStudent.nama,
                kelas: currentStudent.kelas,
                absen: currentStudent.absen,
                benar: benar,
                salah: salah,
                kosong: kosong,
                nilai: nilaiAkhir,
                status: isTuntas ? 'TUNTAS' : 'BELUM TUNTAS',
                waktu: timeStr
            });

            navigateTo('page-result');
        }

