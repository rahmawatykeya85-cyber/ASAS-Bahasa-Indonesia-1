        function exportToCSV() {
            const data = getRekapData();
            if(data.length === 0) {
                alert('Tidak ada data rekapitulasi untuk diunduh.');
                return;
            }

            let csv = 'No,No Peserta,Nama Siswa,Kelas,Absen,Benar,Salah,Kosong,Nilai,Status,Waktu Selesai\n';
            data.forEach((item, idx) => {
                csv += `"${idx+1}","${item.nopes}","${item.nama}","${item.kelas}","${item.absen}","${item.benar}","${item.salah}","${item.kosong}","${item.nilai}","${item.status}","${item.waktu}"\n`;
            });

            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.setAttribute('href', url);
            link.setAttribute('download', `Rekap_SAS_BahasaIndonesia_X_${new Date().toISOString().slice(0,10)}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        function printPDFReport() {
            const data = getRekapData();
            if(data.length === 0) {
                alert('Tidak ada data rekapitulasi untuk dicetak.');
                return;
            }
            document.getElementById('print-date').innerText = new Date().toLocaleDateString('id-ID', {day: 'numeric', month: 'long', year: 'numeric'});
            window.print();
        }

        function clearAllDataConfirm() {
            if(confirm('Apakah Anda yakin ingin MENGHAPUS SELURUH REKAP HASIL UJIAN SISWA? Data yang dihapus tidak dapat dikembalikan.')) {
                localStorage.removeItem('sas_rekap_results');
                renderAdminDashboard();
                alert('Seluruh data rekap hasil ujian telah di-reset.');
            }
        }

        function openModalAddSoal() {
            alert('Fitur Tambah Soal Interaktif dapat dikembangkan lebih lanjut. Saat ini 40 Soal Standar Kurikulum Merdeka Teks LHO sudah dimuat sepenuhnya di Bank Soal.');
        }
    </script>
