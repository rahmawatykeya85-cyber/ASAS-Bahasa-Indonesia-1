            if(saved) {
                try { examSettings = JSON.parse(saved); } catch(e){}
            }
        }

        function saveLocalSettings() {
            localStorage.setItem('sas_settings', JSON.stringify(examSettings));
            updateHomeDisplayInfo();
        }

        function loadLocalQuestions() {
            const saved = localStorage.getItem('sas_questions');
            if(saved) {
                try { currentQuestions = JSON.parse(saved); } catch(e){ currentQuestions = defaultQuestions; }
            } else {
                currentQuestions = defaultQuestions;
                localStorage.setItem('sas_questions', JSON.stringify(defaultQuestions));
            }
        }

        function saveLocalQuestions() {
            localStorage.setItem('sas_questions', JSON.stringify(currentQuestions));
        }

        function getRekapData() {
            const saved = localStorage.getItem('sas_rekap_results');
            return saved ? JSON.parse(saved) : [];
        }

        function saveRekapResult(resultObj) {
            let list = getRekapData();
            // Cek jika nopes sudah ada, update atau add
            const idx = list.findIndex(item => item.nopes === resultObj.nopes);
            if(idx >= 0) {
                list[idx] = resultObj;
            } else {
                list.push(resultObj);
            }
            localStorage.setItem('sas_rekap_results', JSON.stringify(list));
        }

