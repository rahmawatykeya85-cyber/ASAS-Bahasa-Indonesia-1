<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistem Asesmen Sumatif Akhir Semester (SAS) - SMAS Al-Hilaal Tehoru</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            navy: '#1e3a8a',
                            darknavy: '#0f172a',
                            gold: '#d97706',
                            goldlight: '#f59e0b',
                            goldhover: '#b45309',
                            cream: '#fef3c7',
                            softblue: '#eff6ff'
                        }
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome Icon -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
            user-select: none; /* Mencegah copas saat ujian */
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
        /* Print Stylesheet for Report PDF */
        @media print {
            body * {
                visibility: hidden;
            }
            #printable-area, #printable-area * {
                visibility: visible;
            }
            #printable-area {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
                background: white;
                padding: 20px;
            }
            .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body class="text-slate-800 min-h-screen flex flex-col justify-between">

    <!-- HEADER GLOBAL -->
    <header class="bg-brand-navy text-white shadow-md border-b-4 border-brand-gold sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 py-3 flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 bg-brand-gold rounded-full flex items-center justify-center text-brand-navy font-bold text-xl shadow-inner">
                    <i class="fa-solid fa-graduation-cap"></i>
                </div>
                <div>
                    <h1 class="font-extrabold text-sm md:text-lg tracking-wide uppercase">SMAS AL-HILAAL TEHORU</h1>
                    <p class="text-xs text-amber-200">Sistem Asesmen Sumatif Akhir Semester (SAS) Online</p>
                </div>
            </div>
            <div class="flex items-center space-x-2">
                <span id="role-badge" class="hidden md:inline-block bg-blue-900 text-amber-300 text-xs px-3 py-1 rounded-full border border-amber-500/40 font-medium">
                    <i class="fa-solid fa-book-bookmark mr-1"></i> Bahasa Indonesia - Kelas X
                </span>
                <button id="btn-admin-access" onclick="openAdminModal()" class="bg-amber-600 hover:bg-brand-goldhover text-white text-xs px-3 py-1.5 rounded-lg font-semibold transition duration-150 flex items-center shadow">
                    <i class="fa-solid fa-user-gear mr-1.5"></i> <span id="admin-btn-text">Portal Guru</span>
                </button>
            </div>
        </div>
    </header>

    <!-- MAIN CONTENT CONTAINER -->
    <main class="flex-grow max-w-7xl w-full mx-auto p-3 sm:p-4 md:p-6">

        <!-- 1. HALAMAN BERANDA -->
        <section id="page-home" class="space-y-6">
            <div class="bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden">
                <div class="bg-gradient-to-r from-brand-navy via-blue-900 to-slate-900 p-6 md:p-10 text-white relative">
                    <div class="absolute right-4 bottom-0 opacity-10 text-8xl font-black text-amber-400 pointer-events-none">
                        LHO
                    </div>
                    <div class="relative z-10 max-w-3xl">
                        <span class="bg-amber-500/20 text-amber-300 text-xs font-semibold px-3 py-1 rounded-full border border-amber-400/30 uppercase tracking-wider">
                            Tahun Ajaran 2024/2025
                        </span>
                        <h2 class="text-2xl md:text-4xl font-extrabold mt-3 mb-2 text-white leading-tight">
                            ASESMEN SUMATIF AKHIR SEMESTER (SAS)
                        </h2>
                        <p class="text-base md:text-xl font-medium text-amber-200 mb-4">
                            Mata Pelajaran: Bahasa Indonesia (Fase E / Kelas X)
                        </p>
                        <div class="flex flex-wrap gap-4 text-xs md:text-sm text-slate-200 pt-2 border-t border-white/10">
                            <div class="flex items-center"><i class="fa-solid fa-folder-open text-amber-400 mr-2"></i> Materi: Teks Laporan Hasil Observasi</div>
                            <div class="flex items-center"><i class="fa-solid fa-user-tie text-amber-400 mr-2"></i> Pengampu: Rosdiana Waifitu, S.Pd.</div>
                            <div class="flex items-center"><i class="fa-solid fa-clock text-amber-400 mr-2"></i> Durasi: <span id="display-home-duration">90</span> Menit</div>
                        </div>
                    </div>
                </div>

                <div class="p-6 md:p-8 bg-slate-50">
                    <div class="grid md:grid-cols-3 gap-6 mb-8">
                        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-start space-x-4">
                            <div class="p-3 bg-blue-100 text-brand-navy rounded-lg"><i class="fa-solid fa-list-check text-xl"></i></div>
                            <div>
                                <h3 class="font-bold text-slate-800 text-sm">Jumlah Soal</h3>
                                <p class="text-xs text-slate-500 mt-0.5">40 Soal Pilihan Ganda (A-E)</p>
                            </div>
                        </div>
                        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-start space-x-4">
                            <div class="p-3 bg-amber-100 text-brand-gold rounded-lg"><i class="fa-solid fa-bullseye text-xl"></i></div>
                            <div>
                                <h3 class="font-bold text-slate-800 text-sm">Standar KKTP / KKM</h3>
                                <p class="text-xs text-slate-500 mt-0.5">Nilai Ketuntasan Minimum: <span id="display-home-kkm">75</span></p>
                            </div>
                        </div>
                        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-start space-x-4">
                            <div class="p-3 bg-emerald-100 text-emerald-700 rounded-lg"><i class="fa-solid fa-shield-halved text-xl"></i></div>
                            <div>
                                <h3 class="font-bold text-slate-800 text-sm">Sistem CBT Modern</h3>
                                <p class="text-xs text-slate-500 mt-0.5">Auto-Save & Navigasi Soal Ragu</p>
                            </div>
                        </div>
                    </div>

                    <div class="flex flex-col sm:flex-row justify-center items-center gap-4 pt-2">
                        <button onclick="navigateTo('page-identity')" class="w-full sm:w-auto px-8 py-3.5 bg-brand-gold hover:bg-brand-goldhover text-white font-bold text-lg rounded-xl shadow-lg hover:shadow-xl transition-all duration-200 flex items-center justify-center space-x-2">
                            <i class="fa-solid fa-pen-to-square"></i>
                            <span>MULAI ASESMEN SISWA</span>
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <!-- 2. HALAMAN IDENTITAS PESERTA -->
        <section id="page-identity" class="hidden max-w-2xl mx-auto">
            <div class="bg-white rounded-2xl shadow-xl border border-slate-200 p-6 md:p-8">
                <div class="border-b pb-4 mb-6 text-center">
                    <div class="w-12 h-12 bg-blue-100 text-brand-navy rounded-full flex items-center justify-center mx-auto mb-2 text-xl font-bold">
                        <i class="fa-solid fa-id-card"></i>
                    </div>
                    <h2 class="text-2xl font-bold text-brand-navy">Identitas Peserta Didik</h2>
                    <p class="text-xs text-slate-500 mt-1">Lengkapi data diri secara benar sebelum memulai ujian SAS Bahasa Indonesia</p>
                </div>

                <form id="form-identity" onsubmit="submitIdentity(event)" class="space-y-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Nama Lengkap Siswa <span class="text-red-500">*</span></label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400"><i class="fa-solid fa-user"></i></span>
                            <input type="text" id="input-nama" required placeholder="Contoh: Ahmad Abdullah" class="w-full pl-10 pr-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-brand-navy focus:border-brand-navy outline-none text-sm font-medium">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Rombongan Belajar (Kelas) <span class="text-red-500">*</span></label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400"><i class="fa-solid fa-users"></i></span>
                                <select id="input-kelas" required class="w-full pl-10 pr-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-brand-navy focus:border-brand-navy outline-none text-sm font-medium bg-white">
                                    <option value="">-- Pilih Kelas --</option>
                                    <option value="X-1">X-1 (Fase E)</option>
                                    <option value="X-2">X-2 (Fase E)</option>
                                    <option value="X-3">X-3 (Fase E)</option>
                                    <option value="X-4">X-4 (Fase E)</option>
                                </select>
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Nomor Absen <span class="text-red-500">*</span></label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400"><i class="fa-solid fa-list-ol"></i></span>
                                <input type="number" min="1" max="50" id="input-absen" required placeholder="Contoh: 15" class="w-full pl-10 pr-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-brand-navy focus:border-brand-navy outline-none text-sm font-medium">
                            </div>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Nomor Peserta Ujian <span class="text-red-500">*</span></label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400"><i class="fa-solid fa-hashtag"></i></span>
                            <input type="text" id="input-nopes" required placeholder="Contoh: SAS-X-012" class="w-full pl-10 pr-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-brand-navy focus:border-brand-navy outline-none text-sm font-medium">
                        </div>
                    </div>

                    <div class="pt-4 flex items-center justify-between">
                        <button type="button" onclick="navigateTo('page-home')" class="px-4 py-2 text-slate-600 hover:text-slate-800 text-sm font-semibold">
                            <i class="fa-solid fa-arrow-left mr-1"></i> Kembali
                        </button>
                        <button type="submit" class="px-6 py-2.5 bg-brand-navy hover:bg-blue-900 text-white font-bold rounded-lg shadow-md transition-all text-sm flex items-center space-x-2">
                            <span>Lanjut ke Petunjuk</span>
                            <i class="fa-solid fa-arrow-right"></i>
                        </button>
                    </div>
                </form>
            </div>
        </section>

        <!-- 3. HALAMAN PETUNJUK UJIAN -->
        <section id="page-instructions" class="hidden max-w-3xl mx-auto">
            <div class="bg-white rounded-2xl shadow-xl border border-slate-200 p-6 md:p-8">
                <div class="flex items-center space-x-3 border-b pb-4 mb-6">
                    <div class="w-10 h-10 bg-amber-100 text-brand-gold rounded-lg flex items-center justify-center font-bold text-xl">
                        <i class="fa-solid fa-circle-info"></i>
                    </div>
                    <div>
                        <h2 class="text-xl font-bold text-brand-navy">Petunjuk & Tata Tertib Ujian</h2>
                        <p class="text-xs text-slate-500">SMAS Al-Hilaal Tehoru • Bahasa Indonesia Kelas X</p>
                    </div>
                </div>

                <div class="space-y-4 mb-8 text-sm text-slate-700">
                    <div class="p-4 bg-blue-50 border border-blue-200 rounded-xl space-y-2">
                        <div class="font-bold text-brand-navy flex items-center">
                            <i class="fa-solid fa-user-check mr-2"></i> Data Peserta Terverifikasi:
                        </div>
                        <div class="grid grid-cols-2 gap-2 text-xs text-slate-600 pl-6">
                            <div>Nama: <strong id="summary-nama" class="text-slate-800">-</strong></div>
                            <div>Kelas: <strong id="summary-kelas" class="text-slate-800">-</strong></div>
                            <div>No. Absen: <strong id="summary-absen" class="text-slate-800">-</strong></div>
                            <div>No. Ujian: <strong id="summary-nopes" class="text-slate-800">-</strong></div>
                        </div>
                    </div>

                    <div class="space-y-3 pl-2">
                        <div class="flex items-start space-x-3">
                            <span class="w-6 h-6 bg-slate-100 text-brand-navy rounded-full flex items-center justify-center font-bold text-xs flex-shrink-0 mt-0.5">1</span>
                            <p>Ujian terdiri atas <strong>40 Soal Pilihan Ganda</strong> tentang materi <em>Teks Laporan Hasil Observasi (LHO)</em>.</p>
                        </div>
                        <div class="flex items-start space-x-3">
                            <span class="w-6 h-6 bg-slate-100 text-brand-navy rounded-full flex items-center justify-center font-bold text-xs flex-shrink-0 mt-0.5">2</span>
                            <p>Waktu pengerjaan dialokasikan selama <strong><span id="instruction-duration">90</span> Menit</strong>. Timer akan berjalan otomatis saat tombol "Mulai Mengerjakan" diklik.</p>
                        </div>
                        <div class="flex items-start space-x-3">
                            <span class="w-6 h-6 bg-slate-100 text-brand-navy rounded-full flex items-center justify-center font-bold text-xs flex-shrink-0 mt-0.5">3</span>
                            <p>Pilihlah salah satu jawaban (A, B, C, D, atau E) yang paling tepat. Jawaban Anda tersimpan otomatis.</p>
                        </div>
                        <div class="flex items-start space-x-3">
                            <span class="w-6 h-6 bg-slate-100 text-brand-navy rounded-full flex items-center justify-center font-bold text-xs flex-shrink-0 mt-0.5">4</span>
                            <p>Gunakan tombol <strong>"Ragu-Ragu"</strong> jika belum yakin. Indikator navigasi soal ragu-ragu berwarna kuning.</p>
                        </div>
                        <div class="flex items-start space-x-3">
                            <span class="w-6 h-6 bg-slate-100 text-brand-navy rounded-full flex items-center justify-center font-bold text-xs flex-shrink-0 mt-0.5">5</span>
                            <p>Jika waktu habis, sistem akan melakukan <strong>pengumpulan otomatis (auto-submit)</strong> atas seluruh jawaban yang telah dipilih.</p>
                        </div>
                    </div>
                </div>

                <div class="flex justify-between items-center border-t pt-6">
                    <button onclick="navigateTo('page-identity')" class="px-4 py-2 text-slate-600 hover:text-slate-800 text-sm font-semibold">
                        <i class="fa-solid fa-arrow-left mr-1"></i> Edit Identitas
                    </button>
                    <button onclick="startExam()" class="px-8 py-3 bg-brand-gold hover:bg-brand-goldhover text-white font-bold rounded-xl shadow-lg hover:shadow-xl transition-all text-base flex items-center space-x-2">
                        <i class="fa-solid fa-play"></i>
                        <span>MULAI MENGERJAKAN</span>
                    </button>
                </div>
            </div>
        </section>

        <!-- 4. HALAMAN SOAL UJIAN (CBT INTERAKTIF) -->
        <section id="page-exam" class="hidden">
            <!-- BAR NAVIGASI ATAS SOAL -->
            <div class="bg-white rounded-xl shadow-md p-4 mb-4 border border-slate-200 flex flex-wrap justify-between items-center gap-3">
                <div class="flex items-center space-x-3">
                    <span class="bg-brand-navy text-white text-xs md:text-sm font-bold px-3 py-1.5 rounded-lg flex items-center">
                        <i class="fa-solid fa-file-pen mr-2 text-amber-400"></i> SOAL NO. <span id="current-question-num" class="ml-1 text-amber-300 text-base">1</span> / 40
                    </span>
                    <span id="badge-ragu-status" class="hidden bg-amber-100 text-amber-800 border border-amber-300 text-xs font-semibold px-2.5 py-1 rounded-md">
                        <i class="fa-solid fa-bookmark mr-1 text-amber-600"></i> Ditandai Ragu
                    </span>
                </div>
                
                <!-- TIMER -->
                <div class="bg-slate-900 text-white px-4 py-1.5 rounded-lg flex items-center space-x-2 shadow-inner border border-slate-700">
                    <i class="fa-regular fa-clock text-amber-400 animate-pulse"></i>
                    <span class="text-xs text-slate-300 font-medium">Sisa Waktu:</span>
                    <span id="exam-timer" class="font-mono text-base md:text-lg font-bold text-amber-300">01:30:00</span>
                </div>

                <button onclick="toggleNavGridModal()" class="md:hidden bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs px-3 py-1.5 rounded-lg border font-semibold flex items-center">
                    <i class="fa-solid fa-grip mr-1"></i> Grid Soal
                </button>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
                <!-- PANEL UTAMA KONTEN SOAL (3 KOOM LARGESCREEN) -->
                <div class="lg:col-span-3 space-y-4">
                    <div class="bg-white rounded-2xl shadow-lg border border-slate-200 p-5 md:p-8 min-h-[420px] flex flex-col justify-between">
                        <div>
                            <!-- STIMULUS / TEKS KUTIPAN -->
                            <div id="question-stimulus" class="mb-4 p-4 bg-slate-50 border-l-4 border-brand-navy text-xs md:text-sm text-slate-700 rounded-r-lg leading-relaxed whitespace-pre-line font-serif italic shadow-inner">
                                <!-- Dynamic Stimulus Text -->
                            </div>

                            <!-- PERTANYAAN -->
                            <h3 id="question-text" class="text-sm md:text-base font-semibold text-slate-900 mb-6 leading-relaxed">
                                <!-- Dynamic Question Text -->
                            </h3>

                            <!-- PILIHAN JAWABAN (A-E) -->
                            <div id="options-container" class="space-y-3">
                                <!-- Dynamic Options Buttons -->
                            </div>
                        </div>

                        <!-- BAR TOMBOL NAVIGASI BOTTOM -->
                        <div class="flex flex-wrap items-center justify-between gap-3 pt-6 border-t mt-6">
                            <button id="btn-prev" onclick="prevQuestion()" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs md:text-sm rounded-lg border border-slate-300 transition flex items-center space-x-1.5">
                                <i class="fa-solid fa-chevron-left"></i>
                                <span>Sebelumnya</span>
                            </button>

                            <button id="btn-ragu" onclick="toggleRaguCurrent()" class="px-4 py-2 bg-amber-100 hover:bg-amber-200 text-amber-800 border border-amber-300 font-bold text-xs md:text-sm rounded-lg transition flex items-center space-x-1.5">
                                <i class="fa-solid fa-bookmark"></i>
                                <span>Ragu - Ragu</span>
                            </button>

                            <button id="btn-next" onclick="nextQuestion()" class="px-4 py-2 bg-brand-navy hover:bg-blue-900 text-white font-bold text-xs md:text-sm rounded-lg transition flex items-center space-x-1.5">
                                <span>Berikutnya</span>
                                <i class="fa-solid fa-chevron-right"></i>
                            </button>

                            <button id="btn-finish" onclick="confirmSubmitExam()" class="hidden px-5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs md:text-sm rounded-lg shadow-md transition flex items-center space-x-1.5">
                                <i class="fa-solid fa-paper-plane"></i>
                                <span>Selesai & Kumpulkan</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- PANEL NAVIGASI SOAL DESKTOP (1 KOLOM) -->
                <div class="hidden lg:block lg:col-span-1">
                    <div class="bg-white rounded-2xl shadow-lg border border-slate-200 p-5 sticky top-20">
                        <h4 class="font-bold text-slate-800 text-sm mb-3 flex items-center justify-between border-b pb-2">
                            <span><i class="fa-solid fa-grip text-brand-gold mr-1.5"></i> Navigasi Soal</span>
                            <span class="text-xs font-normal text-slate-500"><span id="answered-count">0</span>/40 Terjawab</span>
                        </h4>

                        <!-- LEGEND BADGE -->
                        <div class="grid grid-cols-3 gap-1.5 text-[10px] mb-4 text-center">
                            <div class="p-1 bg-emerald-100 text-emerald-800 border border-emerald-300 rounded font-semibold">Sudah</div>
                            <div class="p-1 bg-amber-100 text-amber-800 border border-amber-300 rounded font-semibold">Ragu</div>
                            <div class="p-1 bg-slate-100 text-slate-600 border border-slate-300 rounded font-semibold">Belum</div>
                        </div>

                        <!-- GRID 40 TOMBOL SOAL -->
                        <div id="desktop-grid-nav" class="grid grid-cols-5 gap-2 max-h-[360px] overflow-y-auto custom-scrollbar p-1">
                            <!-- Dynamic 40 Nav Buttons -->
                        </div>

                        <div class="mt-5 border-t pt-4">
                            <button onclick="confirmSubmitExam()" class="w-full py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-xl shadow transition flex items-center justify-center space-x-1.5">
                                <i class="fa-solid fa-check-double"></i>
                                <span>Kumpulkan Jawaban</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 5. HALAMAN HASIL UJIAN SISWA -->
        <section id="page-result" class="hidden max-w-3xl mx-auto">
            <div class="bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden">
                <!-- RESULT HEADER -->
                <div id="result-banner" class="p-6 md:p-8 text-center text-white bg-gradient-to-r from-brand-navy to-slate-900 relative">
                    <div class="w-20 h-20 bg-white/10 backdrop-blur rounded-full flex items-center justify-center mx-auto mb-3 border border-white/20">
                        <i id="result-icon" class="fa-solid fa-trophy text-4xl text-amber-400"></i>
                    </div>
                    <h2 class="text-2xl md:text-3xl font-extrabold mb-1">Hasil Asesmen SAS</h2>
                    <p class="text-xs md:text-sm text-slate-300">Bahasa Indonesia Kelas X Fase E • SMAS Al-Hilaal Tehoru</p>
                </div>

                <div class="p-6 md:p-8 space-y-6">
                    <!-- DATA IDENTITAS -->
                    <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
                        <div>
                            <span class="text-slate-500 block">Nama Siswa:</span>
                            <strong id="result-nama" class="text-slate-800 text-sm font-bold">--</strong>
