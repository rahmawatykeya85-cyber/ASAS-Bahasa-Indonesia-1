        function renderAdminStats() {
            const data = getRekapData();
            document.getElementById('stat-total-peserta').innerText = data.length;

            if(data.length === 0) {
                document.getElementById('stat-rata-nilai').innerText = '0.0';
                document.getElementById('stat-nilai-max').innerText = '0';
                document.getElementById('stat-nilai-min').innerText = '0';
                return;
            }

            let sum = 0;
            let max = -1;
            let min = 101;

            data.forEach(item => {
                sum += item.nilai;
                if(item.nilai > max) max = item.nilai;
                if(item.nilai < min) min = item.nilai;
            });

            document.getElementById('stat-rata-nilai').innerText = (sum / data.length).toFixed(1);
            document.getElementById('stat-nilai-max').innerText = max;
            document.getElementById('stat-nilai-min').innerText = min;
        }

        function renderAdminRekapTable() {
            let data = getRekapData();
            const search = document.getElementById('filter-search').value.toLowerCase();
            const kelas = document.getElementById('filter-kelas').value;
            const sort = document.getElementById('filter-sort').value;

            // Filter
            data = data.filter(item => {
                const matchSearch = item.nama.toLowerCase().includes(search) || item.nopes.toLowerCase().includes(search);
                const matchKelas = kelas === '' || item.kelas === kelas;
                return matchSearch && matchKelas;
            });

            // Sort
            if(sort === 'nilai-desc') {
                data.sort((a,b) => b.nilai - a.nilai);
            } else if(sort === 'nilai-asc') {
                data.sort((a,b) => a.nilai - b.nilai);
            } else if(sort === 'nama-asc') {
                data.sort((a,b) => a.nama.localeCompare(b.nama));
            }

            const tbody = document.getElementById('table-rekap-body');
            const printBody = document.getElementById('print-table-body');

            if(data.length === 0) {
                tbody.innerHTML = `<tr><td colspan="8" class="text-center py-6 text-slate-400">Belum ada data hasil tes siswa.</td></tr>`;
                printBody.innerHTML = `<tr><td colspan="8" class="text-center py-4">Belum ada data.</td></tr>`;
                return;
            }

            let html = '';
            let printHtml = '';

            data.forEach((item, idx) => {
                const statusBadge = item.status === 'TUNTAS' 
                    ? `<span class="bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded font-bold">TUNTAS</span>`
                    : `<span class="bg-rose-100 text-rose-800 px-2 py-0.5 rounded font-bold">BELUM</span>`;

                html += `
                    <tr class="border-b hover:bg-slate-50">
                        <td class="px-4 py-3 font-semibold">${idx + 1}</td>
                        <td class="px-4 py-3 font-mono font-medium">${item.nopes}</td>
                        <td class="px-4 py-3 font-bold text-slate-900">${item.nama}</td>
                        <td class="px-4 py-3">${item.kelas} (${item.absen})</td>
                        <td class="px-4 py-3 text-center">${item.benar} / ${item.salah} / ${item.kosong}</td>
                        <td class="px-4 py-3 text-center font-extrabold text-brand-navy text-sm">${item.nilai}</td>
                        <td class="px-4 py-3 text-center">${statusBadge}</td>
                        <td class="px-4 py-3 text-slate-500">${item.waktu}</td>
                    </tr>
                `;

                printHtml += `
                    <tr>
                        <td class="border border-slate-400 p-2 text-center">${idx + 1}</td>
                        <td class="border border-slate-400 p-2">${item.nopes}</td>
                        <td class="border border-slate-400 p-2 font-bold">${item.nama}</td>
                        <td class="border border-slate-400 p-2 text-center">${item.kelas}</td>
                        <td class="border border-slate-400 p-2 text-center">${item.benar}</td>
                        <td class="border border-slate-400 p-2 text-center">${item.salah}</td>
                        <td class="border border-slate-400 p-2 text-center font-bold">${item.nilai}</td>
                        <td class="border border-slate-400 p-2 text-center">${item.status}</td>
                    </tr>
                `;
            });

            tbody.innerHTML = html;
            printBody.innerHTML = printHtml;
        }

